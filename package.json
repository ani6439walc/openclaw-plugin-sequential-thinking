{
  "name": "sequential-thinking",
  "displayName": "SequentialThinking",
  "description": "A native OpenClaw plugin that provides the `sequential_thinking` tool for dynamic and reflective problem-solving — no MCP dependency required.",
  "version": "2026.6.8",
  "type": "module",
  "license": "MIT",
  "author": "Ani <ani6439walc@gmail.com>",
  "contributors": [
    "Wan, Jiun Wei <wei840222@gmail.com>"
  ],
  "homepage": "https://github.com/ani6439walc/openclaw-plugin-sequential-thinking#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ani6439walc/openclaw-plugin-sequential-thinking.git"
  },
  "bugs": {
    "url": "https://github.com/ani6439walc/openclaw-plugin-sequential-thinking/issues"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "sequential-thinking"
  ],
  "files": [
    "README.md",
    "package.json",
    "openclaw.plugin.json",
    "dist"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.8",
      "minGatewayVersion": "2026.6.8"
    },
    "build": {
      "openclawVersion": "2026.6.8",
      "pluginSdkVersion": "2026.6.8"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '**/*.md' '**/*.json' '**/*.ts'",
    "test": "vitest run",
    "build": "tsc"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "openclaw": "2026.6.8",
    "typebox": "1.1.39"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "prettier": "3.8.4",
    "vitest": "4.1.8"
  }
}
